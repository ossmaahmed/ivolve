{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "allow-mysql",
    "namespace": "ivolve"
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "mysql"
      }
    },
    "policyTypes": ["Ingress"],
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "ivolve"
              }
            },
            "podSelector": {
              "matchLabels": {
                "app": "mysql"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 3306
          }
        ]
      }
    ]
  }
}
